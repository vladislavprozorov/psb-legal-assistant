# OpenAI-совместимый endpoint. На платформе хакатона подставляется автоматически.
LLM_BASE_URL=https://your-openai-compatible-proxy/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b

# Параметры генерации и поиска
TEMPERATURE=0
MAX_TOKENS=1500
MAX_WORKERS=4
LAW_CONTEXT_CHUNKS=8
USE_EMBEDDINGS=1
USE_RERANKER=1
USE_VERIFIER=1

# Веб-интерфейс
PORT=8000
KB_PATH=/app/data/knowledge-base.zip

# Локальная модель вместо прокси (LM Studio: lms server start, Ollama: ollama serve):
# LLM_BASE_URL=http://localhost:1234/v1   (Ollama: http://localhost:11434/v1; из Docker — host.docker.internal)
# LLM_API_KEY=lm-studio                   (любое непустое значение)
# LLM_MODEL=qwen/qwen3.5-9b
# USE_EMBEDDINGS=0
# USE_RERANKER=0
# DISABLE_THINKING=1                      (отключить рассуждения reasoning-моделей; только для локальных серверов)
# HTTP_TIMEOUT=300
